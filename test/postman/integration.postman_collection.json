{
  "info": {
    "nane": "EIG Integration I1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{gateway}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List assets (authorised)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "X-Correlation-id", "value": "newman-list-003" }
        ],
        "url": "{{gateway}}/v1/assets?limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List assets (unauthorised)",
      "request": { "method": "GET", "url": "{{gateway}}/v1/assets" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401 without token', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
